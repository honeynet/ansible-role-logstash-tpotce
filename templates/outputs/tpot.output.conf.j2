{{ ansible_managed | comment }}
# {{ item.name }} logs
output {
  if "{{ item.name }}" in [tags] and "fails" not in [tags] {
    elasticsearch {
      hosts => {{ logstash_elasticsearch_hosts | to_json }}
      index => "logstash-{{ item.name }}-%{+YYYY.MM.dd}"
      # The composable index template and the ILM policy are owned by the
      # elasticsearch role, so Logstash must not push a template of its own.
      manage_template => false
      ilm_enabled => false
      user => "${ES_USER}"
      password => "${ES_PASSWORD}"
      ssl_enabled => true
      ssl_verification_mode => "{{ logstash_elasticsearch_ssl_verification_mode }}"
      ssl_certificate_authorities => ["{{ logstash_certs_dir }}/elasticsearch-ca.crt"]
    }
  }
}
