---
profile: basic

skip_list:
  # elastic_version, elastic_repo_channel and elastic_version_lock are shared
  # deliberately with the honeynet.elasticsearch and honeynet.kibana roles so
  # that one variable pins the whole stack. index_list is this role's existing
  # public interface for the per-honeypot outputs. Neither can carry a role
  # prefix.
  - var-naming[no-role-prefix]
  # tasks/ssl.yml and tasks/plugins.yml are carried verbatim from the
  # geerlingguy/ansible-role-logstash upstream so that future syncs stay a
  # clean diff. Reformatting them here would make every sync a merge
  # conflict.
  - fqcn[action-core]
  - no-free-form
  - name[casing]
  - yaml[octal-values]
