---
# Kept in step with what ansible-lint enforces, so `yamllint .` and
# `ansible-lint` do not contradict each other.
extends: default

rules:
  line-length:
    max: 160
    level: error
  # Ansible treats "yes"/"no" as booleans and a few upstream-derived files
  # still use them.
  truthy:
    allowed-values: ["true", "false", "yes", "no"]
  # tasks/ssl.yml carries unquoted 0644-style modes from the geerlingguy
  # upstream role. Reformatting them would make every upstream sync a
  # conflict.
  octal-values: disable
  document-start: disable
